---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404">
  <div
    style="font-family:var(--font);background:var(--bg);color:var(--text);display:flex;align-items:center;justify-content:center;min-height:100dvh;flex-direction:column;gap:16px;"
  >
    <div style="font-size:64px;font-weight:700;color:var(--text-muted)">404</div>
    <div style="font-size:16px;color:var(--text-muted)">Halaman tidak ditemukan</div>
    <a
      href="/"
      style="margin-top:8px;padding:8px 20px;background:var(--accent);color:#fff;border-radius:var(--radius-xl);text-decoration:none;font-size:13px;font-weight:500;"
      >Kembali ke Dashboard</a
    >
  </div>
</Layout>
